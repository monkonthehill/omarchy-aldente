#!/usr/bin/env bash
# AlDente Hardware Charge Limit Broker
# Installed to /usr/local/libexec/aldente-set-limit (root:root 0755)
# Strictly validates charge threshold arguments before writing to sysfs.

set -euo pipefail

# 1. Sanitize execution environment
export PATH="/usr/bin:/bin"
unset IFS
unset LD_PRELOAD LD_LIBRARY_PATH

# 2. Enforce root privileges
if [[ $EUID -ne 0 ]]; then
  echo "Error: aldente-set-limit must be executed with root privileges." >&2
  exit 1
fi

# 3. Enforce exactly one argument
if [[ $# -ne 1 ]]; then
  echo "Error: aldente-set-limit requires exactly one argument." >&2
  echo "Usage: /usr/local/libexec/aldente-set-limit <20..100|--restore>" >&2
  exit 1
fi

# 4. Locate and dynamically verify hardware charge limit register
SYSFS_APPLE="/sys/devices/LNXSYSTM:00/LNXSYBUS:00/PNP0A08:00/device:1c/APP0001:00/battery_charge_limit"
CANDIDATE=""

if [[ -f "$SYSFS_APPLE" ]]; then
  CANDIDATE="$SYSFS_APPLE"
else
  for node in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
    if [[ -f "$node" ]]; then
      CANDIDATE="$node"
      break
    fi
  done
fi

if [[ -z "$CANDIDATE" ]]; then
  echo "Error: No supported hardware charge limit register found in sysfs." >&2
  exit 1
fi

REAL_TARGET=$(realpath "$CANDIDATE" 2>/dev/null || true)
if [[ -z "$REAL_TARGET" || ! "$REAL_TARGET" =~ ^/sys/ ]]; then
  echo "Security error: Hardware register does not resolve to a valid /sys path ($REAL_TARGET)" >&2
  exit 1
fi

# Dynamically verify root ownership
TARGET_UID=$(stat -c "%u" "$REAL_TARGET" 2>/dev/null || echo "-1")
if [[ "$TARGET_UID" -ne 0 ]]; then
  echo "Security error: Target register $REAL_TARGET is not owned by root (UID: $TARGET_UID)" >&2
  exit 1
fi

# Dynamically verify permissions: must not be world-writable
TARGET_PERM=$(stat -c "%a" "$REAL_TARGET" 2>/dev/null || echo "777")
if [[ "$TARGET_PERM" =~ [2367]$ ]]; then
  chmod o-w "$REAL_TARGET" 2>/dev/null || true
  TARGET_PERM=$(stat -c "%a" "$REAL_TARGET" 2>/dev/null || echo "777")
  if [[ "$TARGET_PERM" =~ [2367]$ ]]; then
    echo "Security error: Target register $REAL_TARGET is world-writable (mode: $TARGET_PERM)" >&2
    exit 1
  fi
fi

TARGET="$REAL_TARGET"
CONF_FILE="/etc/aldente.conf"
ACTION="$1"

# 5. Handle --restore action (boot / wake / udev event recovery)
if [[ "$ACTION" == "--restore" ]]; then
  TARGET_LIMIT="80"
  if [[ -f "$CONF_FILE" && ! -L "$CONF_FILE" ]]; then
    CONF_OWNER=$(stat -c "%u" "$CONF_FILE" 2>/dev/null || echo "-1")
    CONF_PERM=$(stat -c "%a" "$CONF_FILE" 2>/dev/null || echo "777")
    # Must be owned by root (UID 0) and not world-writable
    if [[ "$CONF_OWNER" == "0" && ! "$CONF_PERM" =~ [2367]$ ]]; then
      STORED=$(head -n 1 "$CONF_FILE" 2>/dev/null | tr -d ' \r\n' || true)
      if [[ "$STORED" =~ ^([2-9][0-9]|100)$ ]]; then
        TARGET_LIMIT="$STORED"
      fi
    fi
  fi
  echo "$TARGET_LIMIT" > "$TARGET"
  echo "Restored hardware charge limit to ${TARGET_LIMIT}% on $TARGET"
  exit 0
fi

# 6. Strictly validate numeric threshold: integer between 20 and 100
if [[ ! "$ACTION" =~ ^([2-9][0-9]|100)$ ]]; then
  echo "Error: Invalid argument '$ACTION'. Must be an integer between 20 and 100, or '--restore'." >&2
  exit 1
fi

LIMIT="$ACTION"
echo "$LIMIT" > "$TARGET"

# 7. Atomically persist validated limit to root-owned /etc/aldente.conf
TMP_CONF=$(mktemp -p /etc .aldente.conf.tmp.XXXXXX 2>/dev/null || mktemp /tmp/aldente.conf.tmp.XXXXXX)
echo "$LIMIT" > "$TMP_CONF"
chmod 0644 "$TMP_CONF"
chown 0:0 "$TMP_CONF"

# Prevent symlink traversal on replacement
if [[ -L "$CONF_FILE" ]]; then
  rm -f "$CONF_FILE"
fi

mv -f "$TMP_CONF" "$CONF_FILE"

echo "Hardware charge limit set to ${LIMIT}% on $TARGET"
exit 0
